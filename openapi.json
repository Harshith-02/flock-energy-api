            },
            "description": "Number of meters per page"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Schneider)",
              "title": "Make"
            },
            "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Schneider)"
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase type (e.g. single, three)",
              "title": "Phase"
            },
            "description": "Filter by phase type (e.g. single, three)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status (e.g. Installed, Decommissioned)",
              "title": "Status"
            },
            "description": "Filter by installation status (e.g. Installed, Decommissioned)"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Distribution Transformer code (e.g. DT-001)",
              "title": "Dt Code"
            },
            "description": "Filter by Distribution Transformer code (e.g. DT-001)"
          },
